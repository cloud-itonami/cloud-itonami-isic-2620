(ns deviceassembly.physics-probe
  "The physical-AI bot's measurement: run this actor's REAL `physics-2d`
  connector mating / insertion-force simulation
  (`deviceassembly.robotics/run-connector-mating-test`) over a fixed
  sweep and print ONE EDN map of the physical quantities it computed.

    kbb -M:dev:physics

  This is what the resident bot (hermes/profiles/physai-isic-2620/SOUL.md)
  reads every tick. Every number is derived from a time-stepped
  trajectory, never typed in. Output schema `itonami.physical-ai.probe.v1`
  (see cloud-itonami-isic-2013's probe for the shared contract).

  `:count` is an evidence floor: the bot treats 0 as \"could not
  measure\", never as \"nothing out of tolerance\". Exit 0 when every run
  produced numbers, 2 when any run did not."
  (:require [deviceassembly.robotics :as robotics]))

(def schema "itonami.physical-ai.probe.v1")

(def sweep
  "Insertion-test configurations swept each tick. Plug masses 1.2 / 1.25
  / 1.3 / 5.0 kg are the store device-units' own recorded
  `:connector-plug-mass-kg` (5.0 kg is the over-force negative control);
  3.0 kg brackets them. The last two runs vary only the insertion rate
  (0.075 and 0.3 m/s vs the 0.15 m/s default) at 1.2 kg so a change in
  the rate coupling shows up."
  [{:plug-mass-kg 1.2}
   {:plug-mass-kg 1.25}
   {:plug-mass-kg 1.3}
   {:plug-mass-kg 3.0}
   {:plug-mass-kg 5.0}
   {:plug-mass-kg 1.2 :insertion-speed-mps 0.075}
   {:plug-mass-kg 1.2 :insertion-speed-mps 0.3}])

(defn- run-one [{:keys [plug-mass-kg] :as input}]
  (let [t (select-keys (robotics/run-connector-mating-test plug-mass-kg (dissoc input :plug-mass-kg))
                       [:sim-peak-insertion-force-n :sim-peak-decel-mps2 :ticks :dt
                        :insertion-speed-mps :travel-to-seat-m])]
    {:input input
     :quantities t
     :out-of-tolerance? (boolean (robotics/connector-mating-force-out-of-tolerance? t))}))

(defn- force-at [mass-kg]
  (:sim-peak-insertion-force-n
   (robotics/connector-mating-telemetry-for {:connector-plug-mass-kg mass-kg})))

(defn max-passing-plug-mass-kg
  "Largest effective plug mass whose simulated peak insertion force stays
  at or under `robotics/max-insertion-force-n`, by bisection over the
  REAL simulation (force is monotone in mass at fixed speed/travel --
  pinned by `robotics-test`). nil when the bracket does not straddle."
  ([] (max-passing-plug-mass-kg 0.001 20.0 40))
  ([lo hi iters]
   (let [ceiling robotics/max-insertion-force-n
         ok? #(<= (force-at %) ceiling)]
     (when (and (ok? lo) (not (ok? hi)))
       (loop [lo lo hi hi i 0]
         (if (>= i iters)
           lo
           (let [mid (/ (+ lo hi) 2.0)]
             (if (ok? mid) (recur mid hi (inc i)) (recur lo mid (inc i))))))))))

(defn probe []
  (let [runs (mapv run-one sweep)
        numeric? (fn [r] (number? (get-in r [:quantities :sim-peak-insertion-force-n])))]
    {:physics-probe/schema schema
     :repo "cloud-itonami/cloud-itonami-isic-2620"
     :procedure "IEC 60512-13-1-style connector mating / insertion-force test (robot burn-in cell)"
     :solver "physics-2d/world-step"
     :runs runs
     :derived {:max-insertion-force-n robotics/max-insertion-force-n
               :max-passing-plug-mass-kg (max-passing-plug-mass-kg)}
     :count (count (filter numeric? runs))
     :expected (count sweep)}))

(defn -main [& _]
  (let [p (probe)]
    (prn p)
    (when-not (= (:count p) (:expected p))
      #?(:cljs (set! (.-exitCode js/process) 2)
         :default (System/exit 2)))))
